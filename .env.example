# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SMTP (email delivery) ───────────────────────────────────────────────────
# Gmail example: use an App Password (not your main password)
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Outlook / Office 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@company.com
# SMTP_PASS=your-password

# SendGrid example (recommended for reliability):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

# ── Recipients ─────────────────────────────────────────────────────────────
# Sender display name + address
EMAIL_FROM=Dorian LPG Intelligence <alerts@yourdomain.com>

# Comma-separated list of recipients
EMAIL_TO=analyst@dorianlpg.com,trader@dorianlepg.com

# ── Scheduler ──────────────────────────────────────────────────────────────
# Cron schedule (UTC). Default: every hour on the hour.
# Examples:
#   "0 * * * *"       every hour
#   "*/30 * * * *"    every 30 minutes
#   "0 6,12,18 * * *" 6am, noon, 6pm UTC
#   "0 8 * * 1-5"     8am UTC weekdays only
CRON_SCHEDULE=0 * * * *

# Set to "false" to print to console instead of sending email (useful for testing)
EMAIL_ENABLED=true

# Set to "false" to skip the immediate run on startup
RUN_ON_START=true
